{
  "name": "phrase-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env.local server/dev.ts",
    "content:daily": "tsx --env-file-if-exists=.env.local scripts/refresh-daily.ts",
    "content:import": "tsx scripts/import-content.ts",
    "content:check-source": "tsx scripts/check-source-window.ts",
    "eval:coach": "tsx --env-file-if-exists=.env.local scripts/evaluate-coach.ts",
    "eval:daily": "tsx --env-file-if-exists=.env.local scripts/evaluate-daily.ts",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src server tests scripts .github *.json *.ts *.html",
    "format": "prettier --write src server tests scripts .github *.json *.ts *.html"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@upstash/redis": "^1.41.0",
    "hono": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
